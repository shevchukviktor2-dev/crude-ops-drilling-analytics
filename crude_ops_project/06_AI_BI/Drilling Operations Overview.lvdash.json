{
  "datasets": [
    {
      "name": "drilling_metrics",
      "displayName": "Drilling Metrics",
      "config": {
        "source": "crude_ops.gold.drilling_stats_summary",
        "measures": [
          {
            "name": "avg_depth",
            "expr": "AVG(avg_depth)",
            "comment": "Mean depth across the time period",
            "displayName": "Average Depth"
          },
          {
            "name": "avg_gamma_ray",
            "expr": "AVG(avg_gamma_ray)",
            "comment": "Mean gamma ray across the time period",
            "displayName": "Average Gamma Ray"
          },
          {
            "name": "total_data_points",
            "expr": "SUM(data_points_count)",
            "comment": "Total number of sensor readings",
            "displayName": "Total Data Points"
          },
          {
            "name": "operation_count",
            "expr": "COUNT(*)",
            "comment": "Count of time intervals per operation",
            "displayName": "Operation Count"
          }
        ],
        "version": "1.1",
        "comment": "Drilling operations metrics for depth and operation analysis",
        "dimensions": [
          {
            "name": "start",
            "expr": "start",
            "comment": "Start time of the interval",
            "displayName": "Timestamp"
          },
          {
            "name": "operation",
            "expr": "operation",
            "comment": "Drilling operation category",
            "displayName": "Operation"
          },
          {
            "name": "phase",
            "expr": "phase",
            "comment": "Drilling phase",
            "displayName": "Phase"
          },
          {
            "name": "productive_status",
            "expr": "CASE WHEN operation = 'Drilling' THEN 'Drilling' ELSE 'Non-productive Time' END",
            "comment": "Groups drilling against all non-drilling activity for high-level time comparison",
            "displayName": "Productive Status"
          }
        ]
      }
    },
    {
      "name": "6cec3066",
      "displayName": "Drilling_Raw_Data",
      "queryLines": [
        "SELECT * FROM crude_ops.gold.drilling_stats_summary"
      ]
    },
    {
      "name": "375cfbf6",
      "displayName": "Drilling_Heat_Map",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  -- group gamma 5 items\n  floor(avg_gamma_ray / 5) * 5 as gamma_group,\n  -- group depth 10 meters\n  floor(avg_depth / 10) * 10 as depth_group,\n  count(*) as density,\n  phase\nFROM crude_ops.gold.drilling_stats_summary\nGROUP BY 1, 2, 4",
        "dimensions": [
          {
            "name": "gamma_group",
            "expr": "source.gamma_group",
            "displayName": "Gamma Group"
          },
          {
            "name": "depth_group",
            "expr": "source.depth_group",
            "displayName": "Depth Group"
          },
          {
            "name": "density",
            "expr": "source.density",
            "displayName": "Density"
          },
          {
            "name": "phase",
            "expr": "source.phase",
            "displayName": "Phase"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
  "pages": [
